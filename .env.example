# ─────────────────────────────────────────────────────────────────────────────
# PayPal WisePayer — Environment Variables Template
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PayPal Sandbox Credentials ───────────────────────────────────────────────
# Get these from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here

# ── Google Gemini LLM (for "Explain My No" card generation) ─────────────────
# Get this from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Channel3 API (product metadata enrichment) ───────────────────────────────
# Register at: https://channel3.ai
CHANNEL3_API_KEY=your_channel3_api_key_here

# ── App Configuration ────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000

# ── Render Deployment (leave blank for local dev) ───────────────────────────
# PORT is auto-set by Render
PORT=8000
